<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework"
             type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
             requirePermission="false" />
  </configSections>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <add name="FinanceiroDb"
         providerName="FirebirdSql.Data.FirebirdClient"
         connectionString="DataSource=localhost;Port=3050;Database=C:\ERP\dados\FINANCEIRO.FDB;User=SYSDBA;Password=masterkey;Charset=UTF8;Dialect=3;Pooling=true" />
  </connectionStrings>

  <appSettings>
    <!-- API REST deste módulo (o ERP Vendas envia os títulos para cá) -->
    <add key="Api.Url" value="http://localhost:9001" />
    <add key="Api.Key" value="financeiro-chave-dev" />
    <!-- API do ERP Vendas (callbacks de quitação/cancelamento) -->
    <add key="Vendas.Url" value="http://localhost:9000" />
    <add key="Vendas.ApiKey" value="vendas-chave-dev" />
    <add key="Vendas.TimeoutMs" value="10000" />
    <!-- Fila de notificações -->
    <add key="Fila.IntervaloSegundos" value="15" />
    <add key="Fila.MaxTentativas" value="10" />
    <!-- Relatórios -->
    <add key="Empresa.Nome" value="Minha Empresa Ltda" />
  </appSettings>

  <entityFramework>
    <defaultConnectionFactory type="EntityFramework.Firebird.FbConnectionFactory, EntityFramework.Firebird" />
    <providers>
      <provider invariantName="FirebirdSql.Data.FirebirdClient"
                type="EntityFramework.Firebird.FbProviderServices, EntityFramework.Firebird" />
    </providers>
  </entityFramework>

  <system.data>
    <DbProviderFactories>
      <remove invariant="FirebirdSql.Data.FirebirdClient" />
      <add name="FirebirdClient Data Provider"
           invariant="FirebirdSql.Data.FirebirdClient"
           description=".NET Framework Data Provider for Firebird"
           type="FirebirdSql.Data.FirebirdClient.FirebirdClientFactory, FirebirdSql.Data.FirebirdClient" />
    </DbProviderFactories>
  </system.data>
</configuration>
